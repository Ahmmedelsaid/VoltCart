{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Jwt": {
    "Issuer": "VoltCart",
    "Audience": "VoltCart.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshReuseGraceSeconds": 10
  },
  "RateLimit": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  }
}
